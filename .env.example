# Public site URL for canonical links, Open Graph, and sitemap (production: https://likhitai.com)
VITE_SITE_URL=https://likhitai.com

# Local dev: point at Express API
VITE_API_URL=http://localhost:5000/api

# Vercel production: leave VITE_API_URL unset OR set to /api
# The app auto-uses /api on likhitai.com and *.vercel.app (see src/config/apiBase.js).
# vercel.json rewrites /api → examsprep-backend.vercel.app (change destination if your API host differs).
#
# Backend Vercel must have: CLIENT_URL=https://likhitai.com
VITE_GOOGLE_CLIENT_ID=95894739982-q63678qsi1ljh6o60h6ab5djo5uv3qql.apps.googleusercontent.com
VITE_RECAPTCHA_SITE_KEY=6Ldw7NUsAAAAANLLjg1k_zpkPOByBNtdftk8Nkj_

# Legal & support contacts (shown on /legal/contact and related pages). Optional — defaults apply if unset.
# VITE_SUPPORT_EMAIL=support@example.com
# VITE_LEGAL_EMAIL=privacy@example.com
# VITE_GRIEVANCE_EMAIL=grievance@example.com
# VITE_ENTERPRISE_SUPPORT_EMAIL=enterprise@example.com